# Copy to .env and edit. .env is git-ignored; never commit real secrets.

# FAST (rule + classical ML) or ADVANCED (adds the transformer layer).
# Leave unset to choose automatically from available RAM.
# AIMES_MODE=FAST

# Dashboard
AIMES_HOST=127.0.0.1
AIMES_PORT=8000
# Generate one: python -c "import secrets;print(secrets.token_hex(32))"
AIMES_SESSION_SECRET=replace-with-a-random-64-character-string

# Gmail OAuth. credentials.json comes from Google Cloud Console (Desktop app).
AIMES_GMAIL_CREDENTIALS=secrets/credentials.json
AIMES_GMAIL_TOKEN=secrets/token.enc
# Encrypts the stored token: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AIMES_TOKEN_KEY=
# Write access is off by default. Turn both on only if you want AIMES/<BAND> labels.
AIMES_GMAIL_ALLOW_MODIFY=false
AIMES_GMAIL_LABEL_HIGH_RISK=false
AIMES_POLL_SECONDS=20
AIMES_MAX_MESSAGES_PER_POLL=25

# Privacy. Bodies are needed for feedback-driven retraining but are not stored by default.
AIMES_STORE_RAW_BODY=false
AIMES_BODY_RETENTION_DAYS=7

# Alerts
AIMES_ALERT_THRESHOLD=60
AIMES_DESKTOP_ALERTS=true
# Free Telegram bot: talk to @BotFather, then get your chat id from @userinfobot
AIMES_TELEGRAM_TOKEN=
AIMES_TELEGRAM_CHAT_ID=

# Risk bands and fusion
AIMES_BAND_SUSPICIOUS=30
AIMES_BAND_HIGH=60
AIMES_BAND_CRITICAL=80
AIMES_FUSION=stacking
